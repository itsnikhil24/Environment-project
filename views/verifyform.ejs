<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manual Verification</title>
  <style>
    body {
      background-color: #121212;
      color: #e0e0e0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
      padding-top: 40px;
    }

    .container {
      background-color: #1e1e1e;
      padding: 30px;
      border-radius: 12px;
      max-width: 800px;
      width: 90%;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
      color: #03dac6;
    }

    p {
      margin: 15px 0;
      font-size: 16px;
    }

    strong {
      color: #bb86fc;
    }

    embed, img {
      display: block;
      margin: 20px auto;
      border: 1px solid #333;
      border-radius: 6px;
    }

    form {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 30px;
    }

    .checkbox-wrapper {
      margin-top: 24px;
      padding: 15px;
      background-color: #1f2a3a;
      border: 1px solid #3c6faf;
      border-radius: 8px;
      display: flex;
      align-items: center;
    }

    .checkbox-wrapper input[type="checkbox"] {
      width: 16px;
      height: 16px;
      margin-right: 10px;
      accent-color: #2196F3;
      cursor: pointer;
    }

    .checkbox-wrapper label {
      font-size: 14px;
      font-weight: 400;
      margin: 0;
      cursor: pointer;
    }

    button[type="submit"] {
      margin-top: 25px;
      padding: 12px 24px;
      font-size: 16px;
      background-color: #444;
      color: #aaa;
      border: none;
      border-radius: 6px;
      transition: background-color 0.3s ease;
      cursor: not-allowed;
    }

    button[type="submit"].active {
      background-color: #00c97e;
      color: #fff;
      cursor: pointer;
    }

    /* Modal */
    #termsModal {
      display: none;
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.8);
    }

    .modal-content {
      background-color: #2b2b2b;
      margin: 10% auto;
      padding: 30px;
      width: 90%;
      max-width: 500px;
      border-radius: 10px;
      text-align: center;
      color: #fff;
    }

    .modal-content h3 {
      margin-bottom: 15px;
    }

    .modal-content p {
      font-size: 14px;
      line-height: 1.6;
    }

    .modal-content button {
      margin-top: 20px;
      padding: 10px 20px;
      background-color: #00c97e;
      border: none;
      border-radius: 6px;
      color: #fff;
      font-weight: bold;
      cursor: pointer;
    }

    .modal-content button:hover {
      background-color: #00b371;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Manual Verification Required</h1>

    <p><strong>Practice:</strong> <%= practice %></p>
    <p><strong>Factory Name (Extracted):</strong> <%= factoryName %></p>
    <p><strong>Proof ID (Extracted):</strong> <%= proofId %></p>

    <% if (proofFile) { %>
      <p><strong>Proof Document:</strong></p>
      <% if (proofFile.endsWith('.pdf')) { %>
        <embed src="<%= proofFile %>" width="100%" height="500px" type="application/pdf" />
      <% } else { %>
        <img src="<%= proofFile %>" alt="Proof Image" width="100%" />
      <% } %>
    <% } %>

    <form action="/verify/submit" method="POST" id="verifyForm">
      <input type="hidden" name="proofId" value="<%= proofId %>" />
      <input type="hidden" name="factoryName" value="<%= factoryName %>" />
      <input type="hidden" name="practice" value="<%= practice %>" />
      <input type="hidden" name="proofFile" value="<%= proofFile %>" />
      <input type="hidden" name="points" value="<%= points %>" />

      <div class="checkbox-wrapper">
        <input type="checkbox" id="confirmCheck" />
        <label for="confirmCheck">I confirm that the above information is accurate.</label>
      </div>

      <button type="submit" id="submitBtn" disabled>Add Practice</button>
    </form>
  </div>

  <!-- Terms Modal -->
  <div id="termsModal">
    <div class="modal-content">
      <h3>Terms & Conditions</h3>
      <p>
        By checking the confirmation, you agree that all submitted data is authentic.
        Any fake or misleading documentation may lead to account suspension or legal action.
      </p>
      <button onclick="acceptTerms()">I Agree</button>
    </div>
  </div>

  <script>
    const checkbox = document.getElementById("confirmCheck");
    const modal = document.getElementById("termsModal");
    const submitBtn = document.getElementById("submitBtn");

    checkbox.addEventListener("change", () => {
      if (checkbox.checked) {
        checkbox.checked = false; // uncheck until user agrees
        modal.style.display = "block";
      }
    });

    function acceptTerms() {
      modal.style.display = "none";
      checkbox.checked = true;
      submitBtn.disabled = false;
      submitBtn.classList.add("active");
    }
  </script>
</body>
</html>
